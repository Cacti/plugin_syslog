msgid "The oldest synchronization record timestamp is unavailable."
msgstr "სინქრონიზაციის უძველესი ჩანაწერის დროის ნიშნული მიუწვდომელია."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "სინქრონიზაცია ჩავარდა ან რიგში მყოფი ჩანაწერები აღემატება დაშვებულ დაყოვნებას."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "დანაყოფის რემონტი დაბლოკილი არაა."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "დანაყოფის რემონტი დაბლოკილი არაა: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Syslog კონვეიერის მდგომარეობა - კოლექტორი %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Syslog კონვეიერი აღდგა."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "%s-ის დანაყოფების განლაგება არასწორი ან არასრულია; დანაყოფების მომსახურება შეჩერდა. შეამოწმეთ დანაყოფების მეტამონაცემები SHOW CREATE TABLE-ით და საჭიროების შემთხვევაში ხელახლა ააგეთ დანაყოფები; ჩაწერა გრძელდება dMaxValue უსაფრთხოების დანაყოფში."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "დარჩენილი დანაყოფების ხარვეზი: %d დანაყოფი"

#: includes/functions.php
msgid "no retention deferral"
msgstr "შენახვის ვადის გადავადების გარეშე"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "შენახვის ვადის მიხედვით გასუფთავება გადავადებულია მომავალი ჰორიზონტის აღდგენამდე"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "ახალი ჩანაწერები გროვდება dMaxValue უსაფრთხოების დანაყოფში"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "თითო გაშვებაზე აღდგენის ლიმიტი მიღწეულია"

#: includes/functions.php
msgid "partition creation failed"
msgstr "დანაყოფის შექმნა ვერ მოხერხდა"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "დანაყოფებად დაყოფის უცნობი დონე; აირჩიეთ „საათობრივი“ ან „დღიური“."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Syslog-ის შენახვის ვადა არასწორია."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "საათობრივი დანაყოფებად დაყოფა ვერ გამოიყენება უვადო შენახვასთან, რადგან ეს მოითხოვდა დანაყოფების შეუზღუდავ რაოდენობას. აირჩიეთ შენახვის პერიოდი ან დღიური დაყოფა."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s დანაყოფებად დაყოფა %s დღიანი შენახვითა და %s დღიანი წინასწარი შექმნის ფანჯრით საჭიროებს %s დანაყოფს თითო ცხრილზე, რაც აღემატება ამ მონაცემთა ბაზის სერვერის %s დანაყოფის ლიმიტს. შეამცირეთ შენახვის ვადა, შეამოკლეთ წინასწარი შექმნის ფანჯარა ან აირჩიეთ დღიური დაყოფა."

