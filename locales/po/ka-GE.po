#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Syslog-ის ცხრილები დანაწევრებული არ არის. ტრადიციული (არადანაწევრებული) ცხრილები მოძველებულია, ხოლო ახალი ინსტალაციებისთვის აუცილებელია დანაწევრებული ცხრილები. თქვენი მონაცემების შეგროვება გაგრძელდება, მაგრამ syslog ცხრილი დანაწევრებულ არქიტექტურაზე უნდა გადაიტანოთ."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "დამუშავების დასრულებული გაშვების მოლოდინში."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "დამუშავება სრულდება დაშვებული დაყოვნების ფარგლებში."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "დამუშავების არცერთი გაშვება არ დასრულებულა %d წამზე მეტი ხნის განმავლობაში."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "შემომავალი შეტყობინებები კონფიგურირებული ლიმიტების ფარგლებშია."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "შემომავალი რიგის მეტრიკები მიუწვდომელია."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "შემომავალ რიგში დაგროვილი სულ მცირე %s შეტყობინება აღემატება %s ლიმიტს."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "უძველესი შემომავალი შეტყობინების დროის ნიშნული მიუწვდომელია."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "დაუმუშავებელი შეტყობინებები %d წამზე ძველია."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "ამ კოლექტორზე სინქრონიზაცია ჩართული არ არის."

