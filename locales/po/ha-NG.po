msgid "Select an import file or paste its contents before importing."
msgstr "Zaɓi fayil ɗin shigowa ko liƙa abubuwan cikinsa kafin shigowa."

#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Teburan Syslog ba su da rarrabawa (partitioned).  Teburan gargajiya (marasa rarrabawa) an daina amfani da su, kuma ana buƙatar teburan da aka rarraba don sabbin shigarwa.  Za a ci gaba da tattara bayananka, amma ya kamata ka mayar da teburin syslog zuwa tsarin rarrabawa."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Ana jiran kammala gudanar da aikin sarrafawa."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Sarrafawa yana kammala cikin jinkirin da aka yarda da shi."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Babu wata gudanarwar sarrafawa da ta kammala fiye da daƙiƙa %d."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Saƙonni masu shigowa suna cikin iyakokin da aka saita."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Ba a sami ma'aunin layin jira mai shigowa ba."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Tarin saƙonni masu shigowa na aƙalla saƙonni %s ya wuce iyakar %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Tambarin lokaci na saƙon da ya shigo mafi tsufa ba ya samuwa."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Saƙonnin da ba a sarrafa su ba sun fi daƙiƙa %d tsufa."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Ba a kunna daidaitawa a kan wannan mai tattarawa ba."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Daidaitawa tana cikin jinkirin da aka yarda da shi."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Ma'aunin layin daidaitawa ba ya samuwa."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Tambarin lokaci na rikodin daidaitawa mafi tsufa ba ya samuwa."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Daidaitawa ta gaza ko kuma bayanan da ke layi sun wuce jinkirin da aka yarda da shi."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Ba a toshe kula da ɓangare ba."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "An toshe kula da ɓangare: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Lafiyar hanyar Syslog - mai tattarawa %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Hanyar aikin Syslog ta farfaɗo."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Tsarin ɓangare na %s ba daidai ba ne ko bai cika ba; an dakatar da kula da ɓangare. Tabbatar da bayanan ɓangaren tare da SHOW CREATE TABLE kuma, idan an buƙata, sake gina ɓangarorin; rubutu zai ci gaba zuwa ɓangaren tsaro na dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "tazarar sashi da ta rage: sashi %d"

#: includes/functions.php
msgid "no retention deferral"
msgstr "babu jinkirin riƙewa"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "an jinkirta yanke riƙewa har sai an dawo da hangen gaba"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "sabbin bayanai suna taruwa a cikin sashin kariya na dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "an kai iyakar farfaɗowa a kowane gudu"

#: includes/functions.php
msgid "partition creation failed"
msgstr "ƙirƙirar sashi ta gaza"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Matakin raba sashe da ba a sani ba; zaɓi Na Sa'a ko Na Kullum."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Adadin lokacin adana Syslog ba daidai ba ne."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Ba za a iya amfani da raba bayanai na kowace sa'a tare da riƙewa na har abada ba, domin hakan zai buƙaci ɓangarori marasa iyaka. Zaɓi lokacin riƙewa ko raba bayanai na kullum."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Rarraba %s tare da kwanakin riƙewa %s da tagar ƙirƙira kafin lokaci ta kwana %s yana buƙatar sassa %s a kowane teburi, wanda ya wuce iyakar sassa %s na wannan sabar rumbun bayanai. Rage lokacin riƙewa, gajarta tagar ƙirƙira kafin lokaci, ko zaɓi rarraba na Kullum."

