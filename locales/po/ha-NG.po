#: includes/functions.php
msgid "Automatic partition recovery deferred: dMaxValue size is unavailable; operator intervention required."
msgstr "An jinkirta dawo da rukunin bayanai da kansa: girman dMaxValue ba ya samuwa; ana buƙatar shigar mai gudanarwa."

#: includes/functions.php
#, php-format
msgid "Automatic partition recovery deferred: dMaxValue has an estimated %s rows and %s bytes; limits are 100000 rows and 134217728 bytes. Operator intervention required."
msgstr "An jinkirta dawo da rukunin bayanai da kansa: dMaxValue yana da kimanin layuka %s da bait %s; iyakokin su ne layuka 100000 da bait 134217728. Ana buƙatar shigar mai gudanarwa."

