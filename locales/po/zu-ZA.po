#: includes/functions.php
#, php-format
msgid "Automatic partition recovery deferred: dMaxValue has an estimated %s rows and %s bytes; limits are 100000 rows and 134217728 bytes. Operator intervention required."
msgstr "Ukubuyiselwa okuzenzakalelayo kwe-partition kuhlehlisiwe: i-dMaxValue inemigqa elinganiselwa ku-%s namabhayithi angu-%s; imikhawulo yimigqa engu-100000 namabhayithi angu-134217728. Kudingeka ukungenelela komqhubi."

