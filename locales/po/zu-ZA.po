#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Amathebula e-Syslog awahlukanisiwe. Amathebula avamile (angahlukanisiwe) asayekwa ukusetshenziswa, futhi amathebula ahlukanisiwe ayadingeka ekufakweni okusha. Idatha yakho izoqhubeka nokugcogcwa, kodwa kufanele uthuthele ithebula le-syslog ekwakhiweni okuhlukanisiwe."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Ilinde ukusebenza kokucubungula okuqediwe."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Ukucubungula kuqedwa phakathi kokubambezeleka okuvunyelwe."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Akukho ukusebenza kokucubungula okuqediwe ngaphezu kwemizuzwana engu-%d."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Imilayezo engenayo ingaphakathi kwemikhawulo elungiselelwe."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Amamethrikhi olayini ongenayo awatholakali."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Inqwaba yemilayezo engenayo okungenani engu-%s yeqa umkhawulo ongu-%s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Isitembu sesikhathi somlayezo ongenayo omdala kakhulu asitholakali."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Imilayezo engacutshunguliwe midala kunamasekhondi angu-%d."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Ukuvumelanisa akunikiwe amandla kulo mqoqi."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Ukuvumelanisa kungaphakathi kokubambezeleka okuvunyelwe."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Amamethrikhi olayini wokuvumelanisa awatholakali."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Isitembu sesikhathi serekhodi lokuvumelanisa elidala kakhulu asitholakali."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Ukuvumelanisa kuhlulekile noma amarekhodi asolayinini edlula ukubambezeleka okuvunyelwe."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Ukugcinwa kwengxenye akuvinjiwe."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Ukugcinwa kwengxenye kuvinjiwe: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Impilo yepayiphi ye-Syslog - umqoqi %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "I-pipeline ye-Syslog isiluleme."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Ukwakheka kwengxenye kwe-%s akuvumelekile noma akuphelele; ukugcinwa kwengxenye kumile. Qinisekisa imethadatha yengxenye nge-SHOW CREATE TABLE futhi, uma kudingeka, yakha kabusha izingxenye; ukubhala kuyaqhubeka kungena engxenyeni yokuphepha ye-dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "isikhala sengxenye esisele: ingxenye/izingxenye ezingu-%d"

#: includes/functions.php
msgid "no retention deferral"
msgstr "akukho ukuhlehliswa kokugcinwa"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "ukunciphisa ukugcinwa kuhlehlisiwe kuze kube yilapho umkhawulo wesikhathi esizayo ubuyiselwa"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "amarekhodi amasha ayaqoqana engxenyeni yokuphepha ye-dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "umkhawulo wokubuyisela ngokusebenza ngakunye ufinyelelwe"

#: includes/functions.php
msgid "partition creation failed"
msgstr "ukudalwa kwengxenye kuhlulekile"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Izinga lokuhlukanisa elingaziwa; khetha Ngehora noma Nsuku zonke."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Isikhathi sokugcinwa kwe-Syslog asivumelekile."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Ukuhlukaniswa kwehora ngalinye ngeke kusetshenziswe nokugcinwa Okungenamkhawulo, okungadinga inani elingenamkhawulo lezingxenye. Khetha isikhathi sokugcina noma ukuhlukaniswa Kwansuku zonke."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Ukuhlukaniswa nge-%s okunezinsuku ezingu-%s zokugcinwa kanye newindi lokwakha ngaphambili lezinsuku ezingu-%s kudinga izigaba ezingu-%s ngethebula ngalinye, okudlula umkhawulo walesi siphakeli sedathabheyisi wezigaba ezingu-%s. Nciphisa isikhathi sokugcinwa, finyeza iwindi lokwakha ngaphambili, noma ukhethe ukuhlukaniswa kwansuku zonke."

