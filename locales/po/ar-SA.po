#, php-format
msgid "%d Day"
msgstr "%d يوم"

#: includes/settings.php syslog_alerts.php
#, php-format
msgid "%d Days"
msgstr "%d أيام"

#: includes/settings.php
msgid "Partition Recovery Limit"
msgstr "حد استرداد الأقسام"

#: includes/settings.php
msgid "When partitions are missing (for example after maintenance downtime), at most this many missing partitions per table are created on each poller run.  The remaining gap heals over subsequent runs; retention pruning stays deferred until the future partition horizon is fully restored.  Applies to partitioned Syslog tables only."
msgstr "عند فقدان أقسام (على سبيل المثال بعد توقف الصيانة)، يتم إنشاء هذا العدد من الأقسام المفقودة كحد أقصى لكل جدول في كل تشغيل للمستطلع (Poller). تُسد الفجوة المتبقية عبر التشغيلات اللاحقة؛ ويظل تقليم الاحتفاظ مؤجلاً حتى تتم استعادة أفق الأقسام المستقبلية بالكامل. ينطبق على جداول Syslog المقسّمة فقط."

#: includes/settings.php
#, php-format
msgid "%d Partition per run"
msgstr "%d قسم لكل تشغيل"

#: includes/settings.php
#, php-format
msgid "%d Partitions per run"
msgstr "%d أقسام لكل تشغيل"

#: includes/settings.php
msgid "Collector Staleness Threshold"
msgstr "عتبة تقادم المجمّع (Collector Staleness)"

#: includes/settings.php
msgid "Pipeline health alerts warn when unprocessed messages, processing completion, or queued synchronization exceed this delay. The effective delay is at least three poller intervals and 300 seconds. Set to 0 to use 300 seconds."
msgstr "تحذر تنبيهات سلامة مسار المعالجة عندما تتجاوز الرسائل غير المعالجة أو إتمام المعالجة أو المزامنة في قائمة الانتظار هذا التأخير. يبلغ التأخير الفعلي ثلاث فترات على الأقل من فترات المستطلع (Poller) و300 ثانية. عيّن القيمة 0 لاستخدام 300 ثانية."

#: includes/settings.php
msgid "Default (300 seconds)"
msgstr "الافتراضي (300 ثانية)"

#: includes/settings.php
#, php-format
msgid "%d seconds"
msgstr "%d ثواني"

#: includes/settings.php
msgid "Collector Backlog Threshold"
msgstr "عتبة تراكم المجمّع (Collector Backlog)"

#: includes/settings.php
msgid "The Syslog Status page shows a warning when more than this many messages sit unprocessed in the Syslog Incoming table.  Set to 0 to use the default of 10000 messages."
msgstr "تعرض صفحة حالة Syslog تحذيراً عندما يتجاوز عدد الرسائل غير المعالجة في جدول Syslog الوارد هذا الحد. اضبطه على 0 لاستخدام القيمة الافتراضية البالغة 10000 رسالة."

