#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "טבלאות Syslog אינן מחולקות למחיצות (partitioned). טבלאות מסורתיות (ללא מחיצות) יצאו משימוש, וטבלאות מחולקות למחיצות נדרשות בהתקנות חדשות. הנתונים שלך ימשיכו להיאסף, אך מומלץ להעביר את טבלת ה-syslog לארכיטקטורת מחיצות."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "ממתין להשלמת ריצת עיבוד."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "העיבוד מסתיים בתוך העיכוב המותר."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "לא הושלמה הרצת עיבוד במשך יותר מ-%d שניות."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "הודעות נכנסות נמצאות בתוך המגבלות המוגדרות."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "מדדי התור הנכנס אינם זמינים."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "צבר נכנס של לפחות %s הודעות חורג מהמגבלה של %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "חותמת הזמן של ההודעה הנכנסת הישנה ביותר אינה זמינה."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "הודעות שטרם עובדו ישנות מ-%d שניות."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "הסנכרון אינו מופעל באספן (collector) זה."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "הסנכרון נמצא בטווח העיכוב המותר."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "מדדי תור הסנכרון אינם זמינים."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "חותמת הזמן של רשומת הסנכרון הישנה ביותר אינה זמינה."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "הסנכרון נכשל או שהרשומות בתור חורגות מהעיכוב המותר."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "תחזוקת מחיצות אינה חסומה."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "תחזוקת המחיצות חסומה: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "תקינות צינור העיבוד של Syslog - אספן %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "צינור העיבוד של Syslog התאושש."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "פריסת המחיצות עבור %s אינה תקינה או חלקית; תחזוקת המחיצות הופסקה. אמת את המטא-נתונים של המחיצות באמצעות SHOW CREATE TABLE ובמידת הצורך בנה מחדש את המחיצות; הכתיבות ממשיכות אל מחיצת הבטיחות dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "פער מחיצות נותר: %d מחיצה/ות"

#: includes/functions.php
msgid "no retention deferral"
msgstr "ללא דחיית שמירה"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "קיצוץ השמירה נדחה עד לשחזור האופק העתידי"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "רשומות חדשות מצטברות במחיצת הבטיחות dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "הושגה מגבלת השחזור להרצה"

#: includes/functions.php
msgid "partition creation failed"
msgstr "יצירת מחיצה נכשלה"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "רמת חלוקה למחיצות לא ידועה; בחר שעתי או יומי."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "ערך שמירת הנתונים של Syslog אינו תקין."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "לא ניתן להשתמש בחלוקה למחיצות לפי שעה עם שמירה ללא הגבלה, שכן הדבר ידרוש מספר בלתי מוגבל של מחיצות. בחר תקופת שמירה או חלוקה למחיצות לפי יום."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "חלוקה למחיצות %s עם שמירה של %s ימים וחלון יצירה מראש של %s ימים דורשת %s מחיצות לטבלה, מה שחורג ממגבלת שרת מסד הנתונים של %s מחיצות. הקטן את משך השמירה, קצר את חלון היצירה מראש, או בחר בחלוקה יומית למחיצות."

