#: includes/functions.php
msgid "Save Failed.  Remote Data Collectors in Sync Mode are not allowed to Save Rules.  Save from the Main Cacti Server instead."
msgstr "ማስቀመጥ አልተሳካም። በማመሳሰል ሁነታ ላይ ያሉ የርቀት ውሂብ ሰብሳቢዎች ደንቦችን እንዲያስቀምጡ አይፈቀድላቸውም። በምትኩ ከዋናው Cacti አገልጋይ ያስቀምጡ።"

#: includes/functions.php
msgid "Please use an HTML Email Client"
msgstr "እባክዎ የHTML ኢሜይል ደንበኛ ይጠቀሙ"

#: includes/functions.php
msgid "Text import payload exceeds the maximum size"
msgstr "የጽሑፍ ማስመጫ ውሂብ መጠን ከከፍተኛው መጠን አልፏል"

#: includes/functions.php
msgid "Unable to read the uploaded import file. Check the file and upload size limit."
msgstr "የተሰቀለውን የማስመጫ ፋይል ማንበብ አልተቻለም። ፋይሉን እና የመስቀያ መጠን ገደቡን ያረጋግጡ።"

#: includes/functions.php
msgid "Select an import file or paste its contents before importing."
msgstr "ከማስመጣትዎ በፊት የማስመጫ ፋይል ይምረጡ ወይም ይዘቱን ይለጥፉ።"

#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "የSyslog ሠንጠረዦች አልተከፋፈሉም (partitioned አይደሉም)። ባህላዊ (ያልተከፋፈሉ) ሠንጠረዦች ከአገልግሎት ውጭ እየሆኑ ሲሆን፣ ለአዲስ ጭነቶች የተከፋፈሉ ሠንጠረዦች ያስፈልጋሉ። ውሂብዎ መሰብሰቡን ይቀጥላል፣ ነገር ግን የsyslog ሠንጠረዡን ወደ ተከፋፈለ አርክቴክቸር ማዛወር አለብዎት።"

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "የተጠናቀቀ የማስኬድ ሂደት በመጠበቅ ላይ።"

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "ማካሄዱ በተፈቀደው መዘግየት ውስጥ እየተጠናቀቀ ነው።"

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "ከ%d ሰከንዶች በላይ ምንም የሂደት አሂድ አልተጠናቀቀም።"

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "ገቢ መልዕክቶች በተዋቀሩት ገደቦች ውስጥ ናቸው።"

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "የገቢ ወረፋ መለኪያዎች አይገኙም።"

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "ቢያንስ የ %s መልዕክቶች ገቢ ክምችት ከ %s ገደብ በላይ ሆኗል።"

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "በጣም የቆየው የገቢ መልእክት የጊዜ ማኅተም አይገኝም።"

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "ያልተሰሩ መልዕክቶች ከ%d ሰከንዶች በላይ የቆዩ ናቸው።"

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "በዚህ ሰብሳቢ ላይ ማመሳሰል አልነቃም።"

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "ማመሳሰል በተፈቀደው መዘግየት ውስጥ ነው።"

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "የማመሳሰል ወረፋ መለኪያዎች አይገኙም።"

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "በጣም የቆየው የማመሳሰያ መዝገብ የጊዜ ማኅተም አይገኝም።"

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "ማመሳሰል አልተሳካም ወይም በወረፋ ላይ ያሉ መዝገቦች ከተፈቀደው መዘግየት በልጠዋል።"

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "የክፍልፋይ ጥገና አልታገደም።"

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "የክፍልፋይ ጥገና ታግዷል: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "የSyslog ሂደት መስመር ጤና - ሰብሳቢ %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "የSyslog የሂደት መስመር (pipeline) አገግሟል።"

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "ለ %s ያለው የክፍልፋይ አቀማመጥ ልክ ያልሆነ ወይም ያልተሟላ ነው፤ የክፍልፋይ ጥገና ቆሟል። የክፍልፋዩን ሜታዳታ በ SHOW CREATE TABLE ያረጋግጡ እና አስፈላጊ ከሆነ ክፍልፋዮቹን እንደገና ይገንቡ፤ ጽሑፎች ወደ dMaxValue የደህንነት ክፍልፋይ መግባታቸውን ይቀጥላሉ።"

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "የቀረው የክፍልፍል ክፍተት፡ %d ክፍልፍል(ሎች)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "የማቆያ ማዘግየት የለም"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "የወደፊቱ አድማስ እስኪመለስ ድረስ የማቆያ መከርከም ዘግይቷል"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "አዲስ መዝገቦች በdMaxValue የደህንነት ክፍልፍል ውስጥ እየተከማቹ ነው"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "በአንድ ሩጫ የማገገሚያ ገደብ ላይ ተደርሷል"

#: includes/functions.php
msgid "partition creation failed"
msgstr "የክፍልፍል መፍጠር አልተሳካም"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "ያልታወቀ የክፍልፍል ደረጃ፤ በየሰዓቱ ወይም በየቀኑ የሚለውን ይምረጡ።"

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "የSyslog የማቆያ ጊዜ ልክ አይደለም።"

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "በሰዓት ክፍፍል ካልተወሰነ የማቆያ ጊዜ ጋር ጥቅም ላይ ሊውል አይችልም፤ ይህ ያልተገደበ የክፍፍሎች ብዛት ያስፈልገዋል። የማቆያ ጊዜ ወይም በየቀኑ ክፍፍል ይምረጡ።"

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s ክፍልፋይ ከ %s ቀናት ማቆያ እና ከ %s ቀን ቅድመ-ፍጠር መስኮት ጋር በአንድ ሰንጠረዥ %s ክፍልፋዮችን ይፈልጋል፣ ይህም የዚህን የውሂብ ጎታ አገልጋይ የ %s ክፍልፋዮች ገደብ ያልፋል። ማቆያውን ይቀንሱ፣ የቅድመ-ፍጠር መስኮቱን ያሳጥሩ፣ ወይም ዕለታዊ ክፍልፋይን ይምረጡ።"

#: includes/functions.php includes/installer.php includes/settings.php
#: syslog.php
msgid "Daily"
msgstr "ዕለታዊ"

#: includes/functions.php includes/installer.php includes/settings.php
#: syslog.php
msgid "Hourly"
msgstr "በየሰዓቱ"

#: includes/functions.php
#, php-format
msgid "The tables still use %s partitions until cli/upgrade_partitioning.php rebuilds them."
msgstr "cli/upgrade_partitioning.php እንደገና እስኪገነባቸው ድረስ ሰንጠረዦቹ አሁንም %s ክፍልፍሎችን ይጠቀማሉ።"

#: includes/functions.php
msgid "The partitioning level of the existing Syslog tables could not be read."
msgstr "የነባር Syslog ሰንጠረዦች የክፍፍል ደረጃ ሊነበብ አልቻለም።"

#: includes/functions.php
msgid "Automatic partition recovery deferred: dMaxValue size is unavailable; operator intervention required."
msgstr "ራስ-ሰር የክፍልፋይ መልሶ ማግኛ ተላልፏል፦ የdMaxValue መጠን አይገኝም፤ የኦፕሬተር ጣልቃ ገብነት ያስፈልጋል።"

#: includes/functions.php
#, php-format
msgid "Automatic partition recovery deferred: dMaxValue has an estimated %s rows and %s bytes; limits are 100000 rows and 134217728 bytes. Operator intervention required."
msgstr "ራስ-ሰር የክፍልፋይ መልሶ ማግኛ ተላልፏል፦ dMaxValue በግምት %s ረድፎች እና %s ባይቶች አሉት፤ ገደቦቹ 100000 ረድፎች እና 134217728 ባይቶች ናቸው። የኦፕሬተር ጣልቃ ገብነት ያስፈልጋል።"

#: includes/functions.php
msgid "Unknown rule type."
msgstr "ያልታወቀ የደንብ ዓይነት።"

#: includes/functions.php
msgid "The configured incoming field mapping is invalid."
msgstr "የተዋቀረው የገቢ መስክ ጥምረት (mapping) ልክ አይደለም።"

#: includes/functions.php
msgid "The facility of this rule is not in the reference table yet."
msgstr "የዚህ ደንብ ፋሲሊቲ ገና በማጣቀሻ ሠንጠረዡ ውስጥ የለም።"

#: includes/functions.php
msgid "Unknown rule match type."
msgstr "ያልታወቀ የደንብ ማዛመጃ ዓይነት።"

#: includes/functions.php
msgid "The rule did not compile to a query."
msgstr "ደንቡ ወደ መጠይቅ አልተቀናበረም።"

