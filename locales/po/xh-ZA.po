#: includes/functions.php
msgid "The partitioning level of the existing Syslog tables could not be read."
msgstr "Inqanaba lokwahlulahlula kweetafile ze-Syslog ezikhoyo alifundekanga."

#: includes/functions.php
msgid "Automatic partition recovery deferred: dMaxValue size is unavailable; operator intervention required."
msgstr "Ukubuyisela ulwahlulo ngokuzenzekelayo kuhlehlisiwe: ubungakanani be-dMaxValue abufumaneki; ungenelelo lomqhubi luyafuneka."

#: includes/functions.php
#, php-format
msgid "Automatic partition recovery deferred: dMaxValue has an estimated %s rows and %s bytes; limits are 100000 rows and 134217728 bytes. Operator intervention required."
msgstr "Ukubuyisela ulwahlulo ngokuzenzekelayo kuhlehlisiwe: i-dMaxValue inemigca eqikelelwa kwi-%s kunye nee-byte ezi-%s; imida yimigca eyi-100000 kunye nee-byte eziyi-134217728. Ungenelelo lomqhubi luyafuneka."

