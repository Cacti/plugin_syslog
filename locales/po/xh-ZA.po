#, php-format
msgid "%d Partition per run"
msgstr "Iphathishini eyi-%d ngokusebenza ngakunye"

#: includes/settings.php
#, php-format
msgid "%d Partitions per run"
msgstr "Iiphathishini ezi-%d ngokusebenza ngakunye"

#: includes/settings.php
msgid "Collector Staleness Threshold"
msgstr "Umda wokuPhelelwa koMqokeleli"

#: includes/settings.php
msgid "Pipeline health alerts warn when unprocessed messages, processing completion, or queued synchronization exceed this delay. The effective delay is at least three poller intervals and 300 seconds. Set to 0 to use 300 seconds."
msgstr "Izivuso zempilo yomjelo wokusebenza zilumkisa xa imiyalezo engekaqhutywa, ukugqitywa kokuqhubekeka, okanye ungqamaniso olusemgceni lugqitha oku kulibaziseka. Ulibaziseko olusebenzayo ubuncinane lungamaxesha amathathu e-Poller kunye nemizuzwana engama-300. Seta ku-0 ukusebenzisa imizuzwana engama-300."

#: includes/settings.php
msgid "Default (300 seconds)"
msgstr "Okungagqibekanga (imizuzwana eyi-300)"

#: includes/settings.php
#, php-format
msgid "%d seconds"
msgstr "%d imizuzwana"

#: includes/settings.php
msgid "Collector Backlog Threshold"
msgstr "Umda woMsebenzi oSaleleyo woMqokeleli"

#: includes/settings.php
msgid "The Syslog Status page shows a warning when more than this many messages sit unprocessed in the Syslog Incoming table.  Set to 0 to use the default of 10000 messages."
msgstr "Iphepha loBume be-Syslog libonisa isilumkiso xa imiyalezo engaphezu kweli nani ihleli ingalungiswanga kwitheyibhile ye-Syslog Incoming.  Seta ku-0 ukusebenzisa ukungagqibeki kwemiyalezo eyi-10000."

#: includes/settings.php
