#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Iiteyibhile ze-Syslog azahlulwanga.  Iiteyibhile zesiqhelo (ezingahlulwanga) azisakhuthazwa, kwaye iiteyibhile ezahluliweyo ziyafuneka kufakelo olutsha.  Idatha yakho iya kuqhubeka iqokelelwa, kodwa kufuneka ufuduse itheyibhile ye-syslog uyise kwisakhiwo esahluliweyo."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Ilindele umsebenzi wokusetyenzwa ogqityiweyo."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Ukucubungula kugqitywa phakathi kolibaziseko oluvumelekileyo."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Akukho kuqhutywa kwenkqubo kugqityiweyo ngaphezu kwemizuzwana engama-%d."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Imiyalezo engenayo ikwimida eqwalaselweyo."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Iimetrikhi zomgca ongenayo azifumaneki."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Umthwalo osalindileyo ongenayo wemiyalezo ubuncinane eyi-%s ugqitha umda we-%s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Ixesha lomyalezo ongenayo omdala kakhulu alifumaneki."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Imiyalezo engasetyenzwanga midala kunemizuzwana eyi-%d."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Ungqamaniso aluvulwanga kulo mqokeleli."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Ungqamaniso lungaphakathi kolibaziseko oluvumelekileyo."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Iimetriki zelayini yongqamaniso azifumaneki."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Ixesha lerekhodi lokungqamanisa elidala kakhulu alifumaneki."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Ungqamaniso aluphumelelanga okanye iirekhodi ezikwilayini zigqithise ulibaziseko oluvumelekileyo."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Ulondolozo lwephathishini aluvalwanga."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Ulondolozo lwephathishini luvaliwe: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Impilo yomjelo we-Syslog - umqokeleli %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "I-pipeline ye-Syslog ibuyele esiqhelweni."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Uyilo lwephathishini lwe-%s alusebenzi okanye aluphelelanga; ulondolozo lwephathishini lumisiwe. Qinisekisa imethadatha yephathishini nge-SHOW CREATE TABLE kwaye, ukuba kuyimfuneko, wakhe kwakhona iiphathishini; ukubhala kuyaqhubeka kwiphathishini yokhuseleko ye-dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "isithuba secandelo esiseleyo: icandelo/amacandelo ali-%d"

#: includes/functions.php
msgid "no retention deferral"
msgstr "akukho kulibaziseka kokugcinwa"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "ukuncitshiswa kokugcinwa kulibazisiwe de kubuyiselwe umda wexesha elizayo"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "iirekhodi ezintsha ziyaqokelelana kwicandelo lokhuseleko le-dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "umda wokubuyisela ngokusebenza ngakunye ufikelelwe"

#: includes/functions.php
msgid "partition creation failed"
msgstr "ukwenziwa kwecandelo akuphumelelanga"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Inqanaba lokwahlula elingaziwayo; khetha NgeYure okanye NgeMini."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Ixesha lokugcina le-Syslog alisebenzi."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Ukwahlula ngeeyure akunakusetyenziswa kunye nogcino olungenasiphelo, nto leyo eya kufuna inani elingenasiphelo lamacandelo. Khetha ixesha logcino okanye ukwahlula ngemihla."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Ulwahlulo lwe-%s oluneentsuku ezi-%s zokugcinwa kunye nefestile yokudala kwangaphambili yeentsuku ezi-%s lufuna izahlulo ezi-%s ngetheyibhile nganye, nto leyo edlula umda wale seva yedathabheyisi wezahlulo ezi-%s. Nciphisa ixesha lokugcinwa, ufinyeze ifestile yokudala kwangaphambili, okanye ukhethe ulwahlulo lwemihla ngemihla."

