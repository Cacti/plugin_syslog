msgid "Import Report Data"
msgstr "Kó Dátà Ìròyìn Wọlé"

#: syslog_reports.php
#, php-format
msgid "NOTE: Report Rule '%s' %s!"
msgstr "ÀKÍYÈSÍ: Òfin Ìjábọ̀ '%s' %s!"

#: syslog_reports.php
#, php-format
msgid "ERROR: Report Rule '%s' %s Failed!"
msgstr "ÀṢÌṢE: Òfin Ìròyìn '%s' %s Kùnà!"

#: syslog_saved_searches.php
msgid "Unable to save the template. Please try again."
msgstr "Kò le fi àdàkọ pamọ́. Jọ̀wọ́ gbìyànjú lẹ́ẹ̀kan sí i."

#: syslog_saved_searches.php
msgid "Enter a template name between 1 and 128 characters."
msgstr "Tẹ orúkọ àdàkọ tí ó wà láàárín àmì 1 sí 128."

#: syslog_saved_searches.php
msgid "Templates"
msgstr "Àwọn Àdàkọ"

#: syslog_saved_searches.php
msgid "Query"
msgstr "Ìbéèrè"

#: syslog_saved_searches.php
msgid "No shared search templates. Save a search for all users from Syslog to create one."
msgstr "Kò sí àwọn àdàkọ ìwádìí tí a pín. Fipamọ́ ìwádìí kan fún gbogbo àwọn olùlò láti Syslog láti ṣẹ̀dá ọ̀kan."

#: syslog_saved_searches.php
msgid "Click 'Continue' to Export the following Saved Search Template(s)."
msgstr "Tẹ 'Tẹ̀síwájú' láti kó àwọn Àdàkọ Àwárí Tí A Fipamọ́ wọ̀nyí jáde."

#: syslog_saved_searches.php
msgid "Click 'Continue' to Delete the following Saved Search Template(s)."
msgstr "Tẹ 'Tẹ̀síwájú' láti Pa Àdàkọ Ìwádìí Tí A Fipamọ́ wọ̀nyí rẹ́."

#: syslog_saved_searches.php
msgid "Delete Saved Search Template(s)"
msgstr "Pa (Àwọn) Àdàkọ Ìwádìí Tí A Fipamọ́ Rẹ́"

#: syslog_saved_searches.php
msgid "Export Saved Search Template(s)"
msgstr "Kó Àwọn Àdàkọ Ìwádìí Tí A Fipamọ́ Jáde"

#: syslog_saved_searches.php
#, php-format
msgid "NOTE: Imported %d and updated %d Saved Search Template(s)."
msgstr "ÀKÍYÈSÍ: A kó %d wọlé, a sì ṣe àtúnṣe Àwọn Àdàkọ Ìwádìí Tí A Fipamọ́ %d."

#: syslog_saved_searches.php
#, php-format
msgid "ERROR: %d Saved Search Template(s) failed to import."
msgstr "ÀṢÌṢE: %d Àdàkọ Ìwádìí Tí A Fipamọ́ kùnà láti kó wọlé."

#: syslog_saved_searches.php
msgid "Import Saved Search Template from Local File"
msgstr "Kó Àdàkọ Ìwádìí Tí A Fipamọ́ Wọlé láti Fáìlì Abẹ́lé"

#: syslog_saved_searches.php
msgid "If the JSON file containing the Saved Search Template definition data is located on your local machine, select it here."
msgstr "Tí fáìlì JSON tí ó ní dátà ìtumọ̀ Àdàkọ Ìwádìí Tí A Fipamọ́ bá wà lórí ẹ̀rọ abẹ́lé rẹ, yàn án níbí."

#: syslog_saved_searches.php
msgid "Import Saved Search Template from Text"
msgstr "Kó Àdàkọ Ìwádìí Tí A Fipamọ́ Wọlé láti Ọ̀rọ̀"

#: syslog_saved_searches.php
msgid "If you have the JSON file containing the Saved Search Template definition data as text, you can paste it into this box to import it."
msgstr "Tí o bá ní fáìlì JSON tí ó ní dátà ìtumọ̀ Àdàkọ Ìwádìí Tí A Fipamọ́ gẹ́gẹ́ bí ọ̀rọ̀, o lè lẹ̀ ẹ́ sínú àpótí yìí láti gbé e wọlé."

#: syslog_saved_searches.php
msgid "Import Saved Search Template"
msgstr "Kó Àdàkọ Ìwádìí Tí A Fipamọ́ Wọlé"

#: syslog_saved_searches.php
msgid "Edit Saved Search Template"
msgstr "Ṣàtúnṣe Àdàkọ Ìwádìí Tí A Fipamọ́"

#: syslog_saved_searches.php
msgid "The name shown to all users in Saved Searches."
msgstr "Orúkọ tí ó hàn sí gbogbo àwọn olùlò nínú Àwọn Ìwádìí Tí A Fipamọ́."

#: syslog_saved_searches.php
msgid "The account that owns this template and can manage it in Saved Searches."
msgstr "Àkọọ́lẹ̀ tí ó ni àdàkọ yìí tí ó sì lè ṣàkóso rẹ̀ nínú Àwọn Ìwádìí Tí a Fipamọ́."

#: syslog_saved_searches.php
msgid "Users who can use this template in addition to its owner. All Users shares it with everyone."
msgstr "Àwọn olùlò tí ó lè lo àdàkọ yìí ní àfikún sí olówó rẹ̀. Gbogbo Àwọn Olùlò máa ń pín in fún gbogbo ènìyàn."

#: syslog_saved_searches.php
msgid "Groups who can use this template in addition to its owner. All Groups shares it with everyone."
msgstr "Àwọn ẹgbẹ́ tí ó lè lo àdàkọ yìí ní àfikún sí olùní rẹ̀. Gbogbo Àwọn Ẹgbẹ́ ń pín in pẹ̀lú gbogbo ènìyàn."

#: syslog_saved_searches.php
msgid "Search Query"
msgstr "Ìbéèrè Ìwádìí"

#: syslog_saved_searches.php
msgid "Correct the query syntax to use the query builder."
msgstr "Tún sínítáàsì ìbéèrè ṣe láti lo olùkọ́ ìbéèrè."

#: syslog_saved_searches.php
msgid "Choose a field, operator, and value. Use AND, OR, NOT, or Group to build the query. Changes apply to this shared template for all users."
msgstr "Yan pápá kan, olùṣiṣẹ́, àti iye. Lo AND, OR, NOT, tàbí Group láti kọ ìbéèrè náà. Àwọn àyípadà wúlò fún Àdàkọ tí a pín yìí fún gbogbo àwọn olùlò."

