msgstr "Ọ̀nà Ìròyìn"

#: syslog_reports.php
msgid "Build filter conditions, or enter the text or SQL expression to match syslog messages."
msgstr "Kọ àwọn ipò àlẹ̀mọ́, tàbí tẹ ọ̀rọ̀ náà tàbí àpèjúwe SQL síi láti bá àwọn ìránṣẹ́ syslog mu."

#: syslog_reports.php
msgid "The information that will be contained in the body of the Report."
