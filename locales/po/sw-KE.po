msgid "Select an import file or paste its contents before importing."
msgstr "Chagua faili ya kuleta au bandika maudhui yake kabla ya kuleta."

#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Majedwali ya Syslog hayajagawanywa. Majedwali ya kawaida (yasiyogawanywa) yamepitwa na wakati, na majedwali yaliyogawanywa yanahitajika kwa usakinishaji mpya. Data yako itaendelea kukusanywa, lakini unapaswa kuhamishia jedwali la syslog kwenye muundo uliogawanywa."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Inasubiri mchakato wa uchakataji ukamilike."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Uchakataji unakamilika ndani ya ucheleweshaji unaoruhusiwa."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Hakuna uendeshaji wa uchakataji uliokamilika kwa zaidi ya sekunde %d."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Ujumbe unaoingia uko ndani ya vikomo vilivyosanidiwa."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Vipimo vya foleni inayoingia havipatikani."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Mrundikano unaoingia wa angalau ujumbe %s unazidi kikomo cha %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Muhuri wa muda wa ujumbe wa zamani zaidi unaoingia haupatikani."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Ujumbe ambao haujachakatwa ni wa zamani zaidi ya sekunde %d."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Usawazishaji haujawashwa kwenye kikusanyaji hiki."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Usawazishaji uko ndani ya ucheleweshaji unaoruhusiwa."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Vipimo vya foleni ya usawazishaji havipatikani."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Muhuri wa muda wa rekodi ya zamani zaidi ya ulandanishi haupatikani."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Usawazishaji umeshindwa au rekodi zilizoko kwenye foleni zimezidi ucheleweshaji unaoruhusiwa."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Matengenezo ya sehemu hayajazuiwa."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Matengenezo ya sehemu yamezuiwa: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Hali ya mkondo wa Syslog - kikusanyaji %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Mfumo wa uchakataji wa Syslog umerejea katika hali ya kawaida."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Mpangilio wa sehemu kwa %s si sahihi au haujakamilika; matengenezo ya sehemu yamesimama. Thibitisha metadata ya sehemu kwa SHOW CREATE TABLE na, ikihitajika, jenga upya sehemu hizo; uandishi unaendelea katika sehemu ya usalama ya dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "pengo la sehemu lililosalia: sehemu %d"

#: includes/functions.php
msgid "no retention deferral"
msgstr "hakuna uahirishaji wa uhifadhi"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "upunguzaji wa uhifadhi umeahirishwa hadi upeo wa baadaye utakaporejeshwa"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "rekodi mpya zinalundikana katika sehemu ya usalama ya dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "kikomo cha urejeshaji kwa kila uendeshaji kimefikiwa"

#: includes/functions.php
msgid "partition creation failed"
msgstr "uundaji wa sehemu umeshindwa"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Kiwango cha ugawaji kisichojulikana; chagua Kila Saa au Kila Siku."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Muda wa kuhifadhi Syslog si sahihi."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Ugawaji wa kila saa hauwezi kutumika na uhifadhi wa milele, ambao ungehitaji idadi isiyo na kikomo ya vigawanyo. Chagua muda wa uhifadhi au ugawaji wa kila siku."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Ugawaji wa %s wenye siku %s za uhifadhi na dirisha la kuunda mapema la siku %s unahitaji vigawanyo %s kwa kila jedwali, jambo linalozidi kikomo cha seva hii ya hifadhidata cha vigawanyo %s. Punguza muda wa uhifadhi, fupisha dirisha la kuunda mapema, au chagua ugawaji wa Kila Siku."

