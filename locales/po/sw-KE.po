#: includes/functions.php
msgid "Automatic partition recovery deferred: dMaxValue size is unavailable; operator intervention required."
msgstr "Urejeshaji wa kiotomatiki wa sehemu umeahirishwa: ukubwa wa dMaxValue haupatikani; uingiliaji wa mwendeshaji unahitajika."

#: includes/functions.php
#, php-format
msgid "Automatic partition recovery deferred: dMaxValue has an estimated %s rows and %s bytes; limits are 100000 rows and 134217728 bytes. Operator intervention required."
msgstr "Urejeshaji wa kiotomatiki wa sehemu umeahirishwa: dMaxValue ina takriban safu mlalo %s na baiti %s; vikomo ni safu mlalo 100000 na baiti 134217728. Uingiliaji wa mwendeshaji unahitajika."

