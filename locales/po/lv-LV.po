#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Syslog tabulas nav particionētas. Tradicionālās (neparticionētās) tabulas ir novecojušas, un jaunām instalācijām ir nepieciešamas particionētas tabulas. Jūsu dati turpinās tikt apkopoti, taču jums vajadzētu migrēt syslog tabulu uz particionētu arhitektūru."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Gaida pabeigtu apstrādes ciklu."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Apstrāde tiek pabeigta atļautās aizkaves ietvaros."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Neviens apstrādes cikls nav pabeigts vairāk nekā %d sekundes."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Ienākošie ziņojumi nepārsniedz konfigurētos ierobežojumus."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Ienākošās rindas metrika nav pieejama."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Ienākošo neapstrādāto ziņojumu skaits (vismaz %s) pārsniedz ierobežojumu %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Vecākā ienākošā ziņojuma laikspiedols nav pieejams."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Neapstrādātie ziņojumi ir vecāki par %d sekundēm."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Sinhronizācija šajā datu vācējā nav iespējota."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Sinhronizācija iekļaujas atļautajā aizkavē."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Sinhronizācijas rindas metrika nav pieejama."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Vecākā sinhronizācijas ieraksta laikspiedols nav pieejams."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Sinhronizācija neizdevās vai rindā esošie ieraksti pārsniedz atļauto aizkavi."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Partīciju uzturēšana nav bloķēta."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Partīciju uzturēšana ir bloķēta: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Syslog apstrādes konveijera stāvoklis - datu vācējs %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Syslog apstrādes konveijers ir atjaunojies."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Tabulas %s partīciju izkārtojums nav derīgs vai ir nepilnīgs; partīciju uzturēšana ir apturēta. Pārbaudiet partīciju metadatus ar SHOW CREATE TABLE un, ja nepieciešams, pārbūvējiet partīcijas; ieraksti turpinās dMaxValue drošības partīcijā."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "atlikušais partīciju iztrūkums: %d partīcija(-as)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "glabāšanas termiņa atlikšanas nav"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "vecu datu dzēšana atlikta, līdz tiks atjaunots nākotnes partīciju horizonts"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "jauni ieraksti uzkrājas dMaxValue drošības partīcijā"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "sasniegts viena cikla atkopšanas ierobežojums"

#: includes/functions.php
msgid "partition creation failed"
msgstr "partīcijas izveide neizdevās"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Nezināms particionēšanas līmenis; izvēlieties \"Ikstundas\" vai \"Ikdienas\"."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Syslog glabāšanas termiņš nav derīgs."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Ikstundas particionēšanu nevar izmantot ar nenoteiktu glabāšanas termiņu, jo tam būtu nepieciešams neierobežots partīciju skaits. Izvēlieties glabāšanas periodu vai ikdienas particionēšanu."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s particionēšanai ar %s dienu glabāšanas termiņu un %s dienu iepriekšējas izveides logu nepieciešamas %s partīcijas katrai tabulai, kas pārsniedz šī datubāzes servera ierobežojumu (%s partīcijas). Samaziniet glabāšanas termiņu, saīsiniet iepriekšējas izveides logu vai izvēlieties ikdienas particionēšanu."

