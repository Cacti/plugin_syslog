msgid "Incoming messages are within the configured limits."
msgstr "Кількість вхідних повідомлень перебуває в межах налаштованих лімітів."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Метрики вхідної черги недоступні."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Черга вхідних повідомлень щонайменше з %s записів перевищує ліміт у %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Позначка часу найдавнішого вхідного повідомлення недоступна."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Необроблені повідомлення старші за %d секунд."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Синхронізацію не ввімкнено на цьому колекторі."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Синхронізація відбувається в межах допустимої затримки."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Метрики черги синхронізації недоступні."

