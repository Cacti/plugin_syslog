msgstr "Конвеєр обробки Syslog відновлено."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Структура розділів для %s є недійсною або неповною; обслуговування розділів зупинено. Перевірте метадані розділів за допомогою SHOW CREATE TABLE і, за потреби, перебудуйте розділи; запис триває до резервного розділу dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "залишковий розрив розділів: %d розділ(ів)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "без відкладення очищення за терміном зберігання"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "очищення за терміном зберігання відкладено до відновлення майбутнього горизонту"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "нові записи накопичуються в резервному розділі dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "досягнуто ліміту відновлення за один запуск"

