#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Οι πίνακες του Syslog δεν είναι διαμερισματοποιημένοι. Οι παραδοσιακοί (μη διαμερισματοποιημένοι) πίνακες είναι παρωχημένοι και για νέες εγκαταστάσεις απαιτούνται διαμερισματοποιημένοι πίνακες. Η συλλογή των δεδομένων σας θα συνεχιστεί, αλλά θα πρέπει να μεταφέρετε τον πίνακα syslog σε διαμερισματοποιημένη αρχιτεκτονική."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Αναμονή για ολοκληρωμένη εκτέλεση επεξεργασίας."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Η επεξεργασία ολοκληρώνεται εντός της επιτρεπόμενης καθυστέρησης."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Δεν έχει ολοκληρωθεί καμία εκτέλεση επεξεργασίας για περισσότερα από %d δευτερόλεπτα."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Τα εισερχόμενα μηνύματα βρίσκονται εντός των ρυθμισμένων ορίων."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Οι μετρήσεις εισερχόμενης ουράς δεν είναι διαθέσιμες."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Εισερχόμενη εκκρεμότητα τουλάχιστον %s μηνυμάτων υπερβαίνει το όριο των %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Η παλαιότερη χρονοσφραγίδα εισερχόμενου μηνύματος δεν είναι διαθέσιμη."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Τα ανεπεξέργαστα μηνύματα είναι παλαιότερα από %d δευτερόλεπτα."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Ο συγχρονισμός δεν είναι ενεργοποιημένος σε αυτόν τον συλλέκτη."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Ο συγχρονισμός βρίσκεται εντός της επιτρεπόμενης καθυστέρησης."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Οι μετρήσεις της ουράς συγχρονισμού δεν είναι διαθέσιμες."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Η παλαιότερη χρονοσφραγίδα εγγραφής συγχρονισμού δεν είναι διαθέσιμη."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Ο συγχρονισμός απέτυχε ή οι εγγραφές στην ουρά υπερβαίνουν την επιτρεπόμενη καθυστέρηση."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Η συντήρηση διαμερισμάτων δεν είναι αποκλεισμένη."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Η συντήρηση διαμερισμάτων έχει αποκλειστεί: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Υγεία διοχέτευσης Syslog - συλλέκτης %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Η ροή επεξεργασίας του Syslog αποκαταστάθηκε."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Η διάταξη διαμερισμάτων για το %s είναι μη έγκυρη ή ελλιπής· η συντήρηση διαμερισμάτων διακόπηκε. Επαληθεύστε τα μεταδεδομένα διαμερισμάτων με SHOW CREATE TABLE και, εάν απαιτείται, ανακατασκευάστε τα διαμερίσματα· οι εγγραφές συνεχίζονται στο διαμέρισμα ασφαλείας dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "υπολειπόμενο κενό διαμερισμάτων: %d διαμέρισμα(-τα)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "καμία αναβολή διατήρησης"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "η εκκαθάριση διατήρησης αναβλήθηκε έως ότου αποκατασταθεί ο μελλοντικός ορίζοντας"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "νέες εγγραφές συσσωρεύονται στο διαμέρισμα ασφαλείας dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "επιτεύχθηκε το όριο ανάκτησης ανά εκτέλεση"

#: includes/functions.php
msgid "partition creation failed"
msgstr "αποτυχία δημιουργίας διαμερίσματος"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Άγνωστο επίπεδο διαμερισματοποίησης· επιλέξτε Ωριαίο ή Ημερήσιο."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Η περίοδος διατήρησης Syslog δεν είναι έγκυρη."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Η ωριαία κατάτμηση δεν μπορεί να χρησιμοποιηθεί με αόριστη διατήρηση, καθώς θα απαιτούσε απεριόριστο αριθμό κατατμήσεων. Επιλέξτε περίοδο διατήρησης ή ημερήσια κατάτμηση."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Το διαμέρισμα %s με %s ημέρες διατήρησης και παράθυρο προδημιουργίας %s ημερών απαιτεί %s διαμερίσματα ανά πίνακα, γεγονός που υπερβαίνει το όριο των %s διαμερισμάτων αυτού του διακομιστή βάσης δεδομένων. Μειώστε τη διατήρηση, συντομεύστε το παράθυρο προδημιουργίας ή επιλέξτε Ημερήσιο διαμέρισμα."

