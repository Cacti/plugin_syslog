msgstr "Kliknite 'Nastavi' za izvoz sljedećih spremljenih predložaka pretraživanja."

#: syslog_saved_searches.php
msgid "Click 'Continue' to Delete the following Saved Search Template(s)."
msgstr "Kliknite 'Nastavi' za brisanje sljedećih spremljenih predložaka pretraživanja."

#: syslog_saved_searches.php
msgid "Delete Saved Search Template(s)"
msgstr "Izbriši spremljene predloške pretraživanja"

#: syslog_saved_searches.php
msgid "Export Saved Search Template(s)"
msgstr "Izvezi spremljene predloške pretraživanja"

#: syslog_saved_searches.php
#, php-format
msgid "NOTE: Imported %d and updated %d Saved Search Template(s)."
msgstr "NAPOMENA: Uvezeno je %d i ažurirano %d spremljenih predložaka pretraživanja."

#: syslog_saved_searches.php
#, php-format
msgid "ERROR: %d Saved Search Template(s) failed to import."
msgstr "POGREŠKA: Uvoz %d spremljenih predložaka pretraživanja nije uspio."

#: syslog_saved_searches.php
msgid "Import Saved Search Template from Local File"
msgstr "Uvezi spremljeni predložak pretraživanja iz lokalne datoteke"

#: syslog_saved_searches.php
msgid "If the JSON file containing the Saved Search Template definition data is located on your local machine, select it here."
msgstr "Ako se JSON datoteka s podacima definicije spremljenog predloška pretraživanja nalazi na vašem lokalnom računalu, odaberite je ovdje."

#: syslog_saved_searches.php
msgid "Import Saved Search Template from Text"
msgstr "Uvezi spremljeni predložak pretraživanja iz teksta"

#: syslog_saved_searches.php
msgid "If you have the JSON file containing the Saved Search Template definition data as text, you can paste it into this box to import it."
msgstr "Ako imate JSON datoteku s podacima definicije spremljenog predloška pretraživanja kao tekst, možete ga zalijepiti u ovaj okvir kako biste ga uvezli."

#: syslog_saved_searches.php
msgid "Import Saved Search Template"
msgstr "Uvezi spremljeni predložak pretraživanja"

#: syslog_saved_searches.php
msgid "Edit Saved Search Template"
msgstr "Uredi spremljeni predložak pretraživanja"

#: syslog_saved_searches.php
msgid "The name shown to all users in Saved Searches."
msgstr "Naziv koji se prikazuje svim korisnicima u Spremljenim pretraživanjima."

#: syslog_saved_searches.php
msgid "The account that owns this template and can manage it in Saved Searches."
msgstr "Račun koji je vlasnik ovog predloška i može njime upravljati u Spremljenim pretraživanjima."

#: syslog_saved_searches.php
msgid "Users who can use this template in addition to its owner. All Users shares it with everyone."
msgstr "Korisnici koji mogu upotrebljavati ovaj predložak uz njegova vlasnika. Opcija Svi korisnici dijeli ga sa svima."

#: syslog_saved_searches.php
msgid "Groups who can use this template in addition to its owner. All Groups shares it with everyone."
msgstr "Grupe koje mogu upotrebljavati ovaj predložak uz njegova vlasnika. Opcija Sve grupe dijeli ga sa svima."

#: syslog_saved_searches.php
msgid "Search Query"
msgstr "Upit pretraživanja"

#: syslog_saved_searches.php
msgid "Correct the query syntax to use the query builder."
msgstr "Ispravite sintaksu upita kako biste upotrebljavali alat za izradu upita."

#: syslog_saved_searches.php
msgid "Choose a field, operator, and value. Use AND, OR, NOT, or Group to build the query. Changes apply to this shared template for all users."
msgstr "Odaberite polje, operator i vrijednost. Upotrijebite AND, OR, NOT ili Grupiraj za izradu upita. Promjene se primjenjuju na ovaj dijeljeni predložak za sve korisnike."
