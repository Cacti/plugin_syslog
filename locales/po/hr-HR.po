#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Tablice sustava Syslog nisu particionirane. Tradicionalne (neparticionirane) tablice su zastarjele, a za nove instalacije potrebne su particionirane tablice. Vaši će se podaci i dalje prikupljati, ali trebali biste migrirati tablicu syslog na particioniranu arhitekturu."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Čekanje na završetak ciklusa obrade."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Obrada se dovršava unutar dopuštenog kašnjenja."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Nijedan ciklus obrade nije dovršen više od %d sekundi."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Dolazne poruke su unutar konfiguriranih ograničenja."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Metrike dolaznog reda čekanja nisu dostupne."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Zaostatak dolaznih poruka od najmanje %s poruka premašuje ograničenje od %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Vremenska oznaka najstarije dolazne poruke nije dostupna."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Neobrađene poruke starije su od %d sekundi."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Sinkronizacija nije omogućena na ovom prikupljaču."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Sinkronizacija je unutar dopuštenog kašnjenja."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Metrike reda čekanja sinkronizacije nisu dostupne."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Vremenska oznaka najstarijeg zapisa sinkronizacije nije dostupna."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Sinkronizacija nije uspjela ili zapisi u redu čekanja premašuju dopušteno kašnjenje."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Održavanje particija nije blokirano."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Održavanje particija je blokirano: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Stanje obradnog toka sustava Syslog - prikupljač %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Obradni tok sustava Syslog se oporavio."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Raspored particija za %s nije valjan ili je nepotpun; održavanje particija je zaustavljeno. Provjerite metapodatke particija pomoću SHOW CREATE TABLE i, ako je potrebno, ponovno izgradite particije; upisi se nastavljaju u sigurnosnu particiju dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "preostali manjak particija: %d particija"

#: includes/functions.php
msgid "no retention deferral"
msgstr "nema odgode zadržavanja"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "čišćenje prema zadržavanju odgođeno je dok se ne obnovi budući horizont"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "novi se zapisi nakupljaju u sigurnosnoj particiji dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "dosegnuto je ograničenje oporavka po ciklusu"

#: includes/functions.php
msgid "partition creation failed"
msgstr "stvaranje particije nije uspjelo"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Nepoznata razina particioniranja; odaberite Satno ili Dnevno."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Razdoblje zadržavanja za Syslog nije valjano."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Satno particioniranje ne može se upotrebljavati s Neograničenim zadržavanjem, za što bi bio potreban neograničen broj particija. Odaberite razdoblje zadržavanja ili Dnevno particioniranje."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s particioniranje s %s dana zadržavanja i okvirom za unaprijed stvorene particije od %s dana zahtijeva %s particija po tablici, što premašuje ograničenje ovog poslužitelja baze podataka od %s particija. Smanjite zadržavanje, skratite okvir za unaprijed stvorene particije ili odaberite Dnevno particioniranje."

