#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Partitie-indeling voor %s is ongeldig of onvolledig; partitieonderhoud gestopt. Controleer de partitiemetadata met SHOW CREATE TABLE en bouw indien nodig de partities opnieuw op; schrijfbewerkingen gaan door naar de dMaxValue-veiligheidspartitie."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "resterend partitiegat: %d partitie(s)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "geen uitstel van bewaartermijn"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "opschonen van bewaartermijn uitgesteld totdat de toekomstige horizon is hersteld"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "nieuwe records hopen zich op in de dMaxValue-veiligheidspartitie"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "herstellimiet per run bereikt"

#: includes/functions.php
msgid "partition creation failed"
msgstr "aanmaken van partitie mislukt"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Onbekend partitioneringsniveau; kies Per uur of Dagelijks."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "De Syslog-retentie is ongeldig."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Uurlijkse partitionering kan niet worden gebruikt met onbeperkte bewaartermijn, omdat dit een onbegrensd aantal partities zou vereisen. Kies een bewaartermijn of dagelijkse partitionering."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s-partitionering met %s dagen bewaartermijn en een vooraf aangemaakte periode van %s dagen vereist %s partities per tabel, wat de limiet van %s partities van deze databaseserver overschrijdt. Verklein de bewaartermijn, verkort de vooraf aangemaakte periode of kies Dagelijkse partitionering."

