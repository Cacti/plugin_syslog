#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Tabele Syslog nie są partycjonowane. Tradycyjne (niepartycjonowane) tabele są przestarzałe, a tabele partycjonowane są wymagane w nowych instalacjach. Dane będą nadal zbierane, ale należy zmigrować tabelę syslog do architektury partycjonowanej."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Oczekiwanie na zakończenie przebiegu przetwarzania."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Przetwarzanie kończy się w ramach dozwolonego opóźnienia."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Żaden przebieg przetwarzania nie został ukończony od ponad %d sekund."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Komunikaty przychodzące mieszczą się w skonfigurowanych limitach."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Metryki kolejki przychodzącej są niedostępne."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Zaległości przychodzące wynoszące co najmniej %s komunikatów przekraczają limit %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Znacznik czasu najstarszego komunikatu przychodzącego jest niedostępny."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Nieprzetworzone komunikaty są starsze niż %d sekund."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Synchronizacja nie jest włączona na tym kolektorze."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Synchronizacja mieści się w dopuszczalnym opóźnieniu."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Metryki kolejki synchronizacji są niedostępne."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Znacznik czasu najstarszego rekordu synchronizacji jest niedostępny."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Synchronizacja nie powiodła się lub liczba rekordów w kolejce przekracza dopuszczalne opóźnienie."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Konserwacja partycji nie jest zablokowana."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Konserwacja partycji jest zablokowana: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Kondycja potoku Syslog – kolektor %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Potok przetwarzania Syslog powrócił do normy."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Układ partycji dla %s jest nieprawidłowy lub niekompletny; zatrzymano konserwację partycji. Zweryfikuj metadane partycji za pomocą SHOW CREATE TABLE i w razie potrzeby przebuduj partycje; zapisy są kontynuowane do bezpiecznej partycji dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "pozostała luka partycji: %d (partycji)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "brak odroczenia retencji"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "czyszczenie retencji odroczone do czasu przywrócenia przyszłego horyzontu"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "nowe rekordy gromadzą się w partycji bezpieczeństwa dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "osiągnięto limit odzyskiwania na jedno uruchomienie"

#: includes/functions.php
msgid "partition creation failed"
msgstr "tworzenie partycji nie powiodło się"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Nieznany poziom partycjonowania; wybierz Godzinowy lub Dzienny."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Okres przechowywania Syslog jest nieprawidłowy."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Partycjonowania godzinowego nie można używać z bezterminowym przechowywaniem, ponieważ wymagałoby to nieograniczonej liczby partycji. Wybierz okres przechowywania lub partycjonowanie dzienne."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Partycjonowanie %s z retencją %s dni i oknem wstępnego tworzenia %s dni wymaga %s partycji na tabelę, co przekracza limit tego serwera bazy danych wynoszący %s partycji. Zmniejsz retencję, skróć okno wstępnego tworzenia lub wybierz partycjonowanie dzienne."

