#, php-format
msgid "%d milliseconds"
msgstr "%d milisekund"

#: includes/settings.php
#, php-format
msgid "%d second"
msgstr "%d sekunda"

#: includes/settings.php
msgid "The Syslog database is unavailable, so the partitioning settings cannot be checked against its partition limit and tables."
msgstr "Baza danych Syslog jest niedostępna, więc nie można sprawdzić ustawień partycjonowania względem jej limitu partycji i tabel."

