#, php-format
msgid "The tables still use %s partitions until cli/upgrade_partitioning.php rebuilds them."
msgstr "Mbola mampiasa fizarana %s ireo tabilao mandra-panamboaran'ny cli/upgrade_partitioning.php azy ireo indray."

#: includes/functions.php
msgid "The partitioning level of the existing Syslog tables could not be read."
msgstr "Tsy voavaky ny haavon'ny fizarazarana ho an'ireo tabilao Syslog efa misy."

#: includes/functions.php
msgid "Automatic partition recovery deferred: dMaxValue size is unavailable; operator intervention required."
msgstr "Nahemotra ny famerenana ny fizarana mandeha ho azy: tsy hita ny haben'ny dMaxValue; ilaina ny fandraisan'andraikitry ny mpandraharaha."

#: includes/functions.php
#, php-format
msgid "Automatic partition recovery deferred: dMaxValue has an estimated %s rows and %s bytes; limits are 100000 rows and 134217728 bytes. Operator intervention required."
msgstr "Nahemotra ny famerenana ny fizarana mandeha ho azy: ny dMaxValue dia tombanana ho manana andalana %s sy oktety %s; ny fetra dia andalana 100000 sy oktety 134217728. Ilaina ny fandraisan'andraikitry ny mpandraharaha."

