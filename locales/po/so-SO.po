msgid "Automatic partition recovery deferred: dMaxValue size is unavailable; operator intervention required."
msgstr "Soo celinta qeybta ee tooska ah waa la dib dhigay: cabbirka dMaxValue lama heli karo; faragelinta hawlwadeenka ayaa loo baahan yahay."

#: includes/functions.php
