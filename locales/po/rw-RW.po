msgid "Incoming messages are within the configured limits."
msgstr "Ubutumwa bwinjira buri mu mipaka yagenwe."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Ibipimo by'umurongo w'ubutumwa bwinjira ntibiboneka."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Ibirarane byinjira by'ubutumwa nibura %s birenze umupaka wa %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Igihe cy'ubutumwa bwinjiye bwa kera kurusha ubundi ntibibonetse."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Ubutumwa butarakorwaho burengeje amasegonda %d."

