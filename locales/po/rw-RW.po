msgstr "Ihuza ry'amakuru ntiryafunguwe kuri iki gikusanyamakuru."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Ihuza ry'amakuru riri mu gihe cyemewe."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Ibipimo by'umurongo w'ihuza ry'amakuru ntibiboneka."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Igihe cy'inyandiko y'ihuzamakuru ya kera kurusha izindi ntibibonetse."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Ihuza ry'amakuru ryananiwe cyangwa ibyanditswe biri ku murongo birenze igihe cyemewe."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Kubungabunga ibice ntikwazitiwe."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Kubungabunga ibice kwazitiwe: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Ubuzima bw'umuyoboro wa Syslog - igikusanyamakuru %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Umuyoboro wa Syslog wongeye gukora neza."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Imiterere y'ibice bya %s ntiyemewe cyangwa ntiyuzuye; kubungabunga ibice byahagaze. Genzura amakuru nyirizina y'ibice ukoresheje SHOW CREATE TABLE kandi, nibiba ngombwa, wongere wubake ibice; kwandika bikomeza mu gice cy'umutekano cya dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "icyuho cy'igice gisigaye: ibice %d"

#: includes/functions.php
msgid "no retention deferral"
msgstr "nta kwimura igihe cyo kubika"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "gukuraho ibibitswe byimuriwe imbere kugeza igihe cy'ahazaza kigarutse"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "inyandiko nshya ziri kwiyongera mu gice cy'umutekano cya dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "umupaka wo kugarura kuri buri nshuro wagezweho"

#: includes/functions.php
msgid "partition creation failed"
msgstr "gushyiraho igice byanze"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Urwego rw'igabanyamabika rutazwi; hitamo Buri saha cyangwa Buri munsi."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Igihe cyo kubika amakuru ya Syslog ntabwo cyemewe."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Igabanya rya buri saha ntirishobora gukoreshwa hamwe n'Ububiko butagira iherezo, ibyo byasaba umubare utagira umupaka w'ibice. Hitamo igihe cyo kubika cyangwa igabanya rya buri munsi."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Igabanyamice rya %s rifite iminsi %s yo kubika n'iminsi %s yo guteganya kurema mbere rikeneye ibice %s kuri buri mbonerahamwe, bikaba birenga umubare ntarengwa wa seriveri y'ububiko bw'amakuru w'ibice %s. Gabanya iminsi yo kubika, uhine igihe cyo kurema mbere, cyangwa uhitemo igabanyamice rya Buri munsi."

