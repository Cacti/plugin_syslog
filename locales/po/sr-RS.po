#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Syslog табеле нису партиционисане. Традиционалне (непартиционисане) табеле су застареле, а партиционисане табеле су обавезне за нове инсталације. Ваши подаци ће наставити да се прикупљају, али требало би да мигрирате syslog табелу на партиционисану архитектуру."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Чекање на завршено извршавање обраде."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Обрада се завршава у оквиру дозвољеног кашњења."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Ниједно извршавање обраде није завршено дуже од %d секунди."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Долазне поруке су у оквиру конфигурисаних ограничења."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Метрике долазног реда нису доступне."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Заостатак од најмање %s долазних порука премашује ограничење од %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Временска ознака најстарије долазне поруке није доступна."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Необрађене поруке су старије од %d секунди."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Синхронизација није омогућена на овом сакупљачу."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Синхронизација је у оквиру дозвољеног кашњења."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Метрике реда синхронизације нису доступне."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Временска ознака најстаријег записа синхронизације није доступна."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Синхронизација није успела или записи у реду премашују дозвољено кашњење."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Одржавање партиција није блокирано."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Одржавање партиција је блокирано: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Стање Syslog цевовода - сакупљач %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Syslog цевовод се опоравио."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Распоред партиција за %s је неважећи или непотпун; одржавање партиција је заустављено. Проверите метаподатке партиција помоћу SHOW CREATE TABLE и, ако је потребно, поново изградите партиције; уписи се настављају у сигурносну партицију dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "преостала празнина партиција: %d партиција(е)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "нема одлагања задржавања"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "чишћење ради задржавања је одложено док се не обнови будући хоризонт"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "нови записи се нагомилавају у сигурносној партицији dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "достигнуто је ограничење опоравка по извршавању"

#: includes/functions.php
msgid "partition creation failed"
msgstr "креирање партиције није успело"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Непознат ниво партиционисања; изаберите По сату или Дневно."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Период задржавања за Syslog је неважећи."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Партиционисање по сату не може се користити са Неограниченим задржавањем, јер би то захтевало неограничен број партиција. Изаберите период задржавања или Дневно партиционисање."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s партиционисање са %s дана задржавања и периодом за креирање унапред од %s дана захтева %s партиција по табели, што премашује ограничење овог сервера базе података од %s партиција. Смањите задржавање, скратите период за креирање унапред или изаберите Дневно партиционисање."

