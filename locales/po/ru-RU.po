msgstr "Метка времени самой старой записи синхронизации недоступна."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Синхронизация завершилась с ошибкой, или количество записей в очереди превышает допустимую задержку."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Обслуживание разделов не заблокировано."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Обслуживание разделов заблокировано: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Состояние конвейера Syslog — коллектор %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Конвейер Syslog восстановил работу."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Структура разделов для %s некорректна или неполна; обслуживание разделов остановлено. Проверьте метаданные разделов с помощью SHOW CREATE TABLE и при необходимости пересоздайте разделы; запись продолжается в резервный раздел dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "оставшийся пробел секций: %d секц."

#: includes/functions.php
msgid "no retention deferral"
msgstr "без отсрочки очистки по сроку хранения"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "удаление по сроку хранения отложено до восстановления горизонта будущих секций"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "новые записи накапливаются в резервной секции dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "достигнут лимит восстановления за один запуск"

#: includes/functions.php
msgid "partition creation failed"
msgstr "ошибка создания раздела"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Неизвестный уровень секционирования; выберите «Почасовой» или «Ежедневный»."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Указан недопустимый срок хранения Syslog."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Почасовое секционирование нельзя использовать при бессрочном хранении, так как это потребовало бы неограниченного числа секций. Выберите срок хранения или ежедневное секционирование."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Секционирование (%s) со сроком хранения %s дн. и окном предварительного создания %s дн. требует %s секций на таблицу, что превышает ограничение этого сервера баз данных (%s секций). Уменьшите срок хранения, сократите окно предварительного создания или выберите ежедневное секционирование."

