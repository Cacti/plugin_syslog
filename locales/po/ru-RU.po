msgid "Incoming messages are within the configured limits."
msgstr "Входящие сообщения находятся в пределах настроенных лимитов."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Метрики входящей очереди недоступны."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Входящая очередь как минимум из %s сообщений превышает лимит %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Метка времени самого старого входящего сообщения недоступна."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Необработанные сообщения старше %d секунд."

