#: includes/functions.php
msgid "Select an import file or paste its contents before importing."
msgstr "आयात करने से पहले कोई आयात फ़ाइल चुनें या उसकी सामग्री पेस्ट करें।"

#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Syslog तालिकाएँ विभाजित (partitioned) नहीं हैं। पारंपरिक (गैर-विभाजित) तालिकाएँ अप्रचलित हो चुकी हैं, और नए इंस्टॉल के लिए विभाजित तालिकाएँ आवश्यक हैं। आपका डेटा एकत्र होना जारी रहेगा, लेकिन आपको syslog तालिका को विभाजित आर्किटेक्चर में माइग्रेट करना चाहिए।"

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "पूर्ण प्रोसेसिंग रन की प्रतीक्षा की जा रही है।"

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "प्रोसेसिंग अनुमत विलंब के भीतर पूरी हो रही है।"

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "%d सेकंड से अधिक समय से कोई भी प्रोसेसिंग रन पूरा नहीं हुआ है।"

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "इनकमिंग संदेश कॉन्फ़िगर की गई सीमाओं के भीतर हैं।"

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "इनकमिंग कतार मेट्रिक्स अनुपलब्ध हैं।"

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "कम से कम %s संदेशों का इनकमिंग बैकलॉग %s की सीमा से अधिक है।"

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "सबसे पुराने इनकमिंग संदेश का टाइमस्टैम्प अनुपलब्ध है।"

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "असंसाधित संदेश %d सेकंड से अधिक पुराने हैं।"

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "इस कलेक्टर पर सिंक्रनाइज़ेशन सक्षम नहीं है।"

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "सिंक्रनाइज़ेशन अनुमत विलंब सीमा के भीतर है।"

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "सिंक्रनाइज़ेशन कतार के मेट्रिक्स उपलब्ध नहीं हैं।"

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "सबसे पुराने सिंक्रनाइज़ेशन रिकॉर्ड का टाइमस्टैम्प अनुपलब्ध है।"

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "सिंक्रनाइज़ेशन विफल हो गया है या कतारबद्ध रिकॉर्ड अनुमत विलंब से अधिक हो गए हैं।"

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "पार्टीशन रखरखाव अवरुद्ध नहीं है।"

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "पार्टीशन रखरखाव अवरुद्ध है: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Syslog पाइपलाइन स्थिति - कलेक्टर %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Syslog पाइपलाइन पुनः ठीक हो गई है।"

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "%s के लिए विभाजन (Partition) लेआउट अमान्य या अधूरा है; विभाजन रखरखाव रोक दिया गया है। SHOW CREATE TABLE के साथ विभाजन मेटाडेटा सत्यापित करें और यदि आवश्यक हो तो विभाजनों को पुनः निर्मित करें; डेटा लेखन dMaxValue सुरक्षा विभाजन में जारी रहेगा।"

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "शेष विभाजन अंतराल: %d विभाजन"

#: includes/functions.php
msgid "no retention deferral"
msgstr "कोई प्रतिधारण स्थगन नहीं"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "भविष्य का क्षितिज बहाल होने तक प्रतिधारण छंटाई स्थगित"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "dMaxValue सुरक्षा विभाजन में नए रिकॉर्ड जमा हो रहे हैं"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "प्रति रन पुनर्प्राप्ति सीमा पूरी हो गई"

#: includes/functions.php
msgid "partition creation failed"
msgstr "पार्टीशन बनाना विफल रहा"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "अज्ञात विभाजन स्तर; प्रति घंटा (Hourly) या दैनिक (Daily) चुनें।"

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Syslog प्रतिधारण अमान्य है।"

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "अनिश्चितकालीन प्रतिधारण के साथ प्रति घंटा विभाजन (Hourly partitioning) का उपयोग नहीं किया जा सकता, क्योंकि इसके लिए असीमित संख्या में विभाजनों की आवश्यकता होगी। कृपया एक प्रतिधारण अवधि या दैनिक विभाजन चुनें।"

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s पार्टीशनिंग को %s दिनों की प्रतिधारण अवधि और %s दिनों की पूर्व-निर्माण विंडो के साथ प्रति तालिका %s पार्टीशन की आवश्यकता है, जो इस डेटाबेस सर्वर की %s पार्टीशन की सीमा से अधिक है। प्रतिधारण अवधि कम करें, पूर्व-निर्माण विंडो छोटी करें, या दैनिक पार्टीशनिंग चुनें।"

