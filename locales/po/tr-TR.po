#: syslog_saved_searches.php
msgid "No shared search templates. Save a search for all users from Syslog to create one."
msgstr "Paylaşılan arama şablonu yok. Oluşturmak için Syslog'dan tüm kullanıcılar için bir arama kaydedin."

#: syslog_saved_searches.php
msgid "Click 'Continue' to Export the following Saved Search Template(s)."
msgstr "Aşağıdaki Kayıtlı Arama Şablonlarını dışa aktarmak için 'Devam Et'e tıklayın."

#: syslog_saved_searches.php
msgid "Click 'Continue' to Delete the following Saved Search Template(s)."
msgstr "Aşağıdaki Kayıtlı Arama Şablonlarını silmek için 'Devam Et'e tıklayın."

