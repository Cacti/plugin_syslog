msgstr "En az %s mesajlık gelen birikim %s sınırını aşıyor."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "En eski gelen ileti zaman damgası kullanılamıyor."

#: includes/functions.php
#, php-format
