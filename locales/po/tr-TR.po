msgstr "En eski eşitleme kaydı zaman damgası kullanılamıyor."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Eşitleme başarısız oldu veya kuyruktaki kayıtlar izin verilen gecikmeyi aşıyor."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Bölüm bakımı engellenmiyor."

#: includes/functions.php
#, php-format
msgid "Partition maintenance is blocked: %s"
msgstr "Bölüm bakımı engellendi: %s"

#: includes/functions.php
#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Syslog işlem hattı durumu - toplayıcı %d"

