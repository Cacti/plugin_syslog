msgstr "Gelen mesajlar yapılandırılan sınırlar içinde."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Gelen kuyruk metrikleri kullanılamıyor."

#: includes/functions.php
