msgstr "Trạng thái luồng xử lý Syslog - bộ thu thập %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Luồng xử lý Syslog đã khôi phục."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Bố cục phân vùng cho %s không hợp lệ hoặc chưa đầy đủ; việc bảo trì phân vùng đã dừng. Hãy xác minh siêu dữ liệu phân vùng bằng SHOW CREATE TABLE và xây dựng lại các phân vùng nếu cần; dữ liệu ghi tiếp tục đi vào phân vùng an toàn dMaxValue."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "khoảng thiếu phân vùng còn lại: %d phân vùng"

#: includes/functions.php
msgid "no retention deferral"
msgstr "không hoãn lưu giữ"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "việc cắt tỉa theo thời gian lưu giữ bị hoãn cho đến khi ngưỡng tương lai được khôi phục"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "các bản ghi mới đang tích lũy trong phân vùng dự phòng dMaxValue"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "đã đạt giới hạn khôi phục mỗi lần chạy"

