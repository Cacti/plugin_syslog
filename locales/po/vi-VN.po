msgstr "Đang chờ một lượt xử lý hoàn tất."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Quá trình xử lý đang hoàn tất trong độ trễ cho phép."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Không có lượt xử lý nào hoàn tất trong hơn %d giây qua."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Các thông điệp đầu vào nằm trong giới hạn đã cấu hình."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Không có sẵn chỉ số hàng đợi đầu vào."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Lượng tin tồn đọng đầu vào ít nhất %s thông điệp vượt quá giới hạn %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Không có dấu thời gian của thông điệp đến cũ nhất."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Các thông báo chưa được xử lý đã cũ hơn %d giây."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Đồng bộ hóa chưa được bật trên trình thu thập này."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Quá trình đồng bộ hóa nằm trong độ trễ cho phép."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Không có số liệu hàng đợi đồng bộ hóa."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Không có dấu thời gian của bản ghi đồng bộ hóa cũ nhất."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Đồng bộ hóa thất bại hoặc các bản ghi trong hàng đợi vượt quá độ trễ cho phép."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Bảo trì phân vùng không bị chặn."

#: includes/functions.php
