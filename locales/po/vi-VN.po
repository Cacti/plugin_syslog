msgstr "tạo phân vùng thất bại"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Mức phân vùng không xác định; hãy chọn Hàng giờ hoặc Hàng ngày."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Thời gian lưu giữ Syslog không hợp lệ."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Không thể sử dụng phân vùng theo giờ với chế độ lưu giữ Vô thời hạn, vì sẽ cần số lượng phân vùng không giới hạn. Hãy chọn một khoảng thời gian lưu giữ hoặc phân vùng theo ngày."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "Phân vùng %s với thời gian lưu giữ %s ngày và khoảng tạo trước %s ngày cần %s phân vùng cho mỗi bảng, vượt quá giới hạn %s phân vùng của máy chủ cơ sở dữ liệu này. Hãy giảm thời gian lưu giữ, rút ngắn khoảng tạo trước hoặc chọn phân vùng Hàng ngày."

