#: includes/functions.php
msgid "The Syslog tables are not partitioned.  Traditional (non-partitioned) tables are deprecated, and partitioned tables are required for new installs.  Your data will continue to be collected, but you should migrate the syslog table to a partitioned architecture."
msgstr "Die Syslog-tabelle is nie gepartisioneer nie. Tradisionele (nie-gepartisioneerde) tabelle is verouderd, en gepartisioneerde tabelle word vereis vir nuwe installasies. U data sal steeds ingesamel word, maar u behoort die syslog-tabel na 'n gepartisioneerde argitektuur te migreer."

#: includes/functions.php
msgid "Waiting for a completed processing run."
msgstr "Wag vir 'n voltooide verwerkingslopie."

#: includes/functions.php
msgid "Processing is completing within the allowed delay."
msgstr "Verwerking word binne die toegelate vertraging voltooi."

#: includes/functions.php
#, php-format
msgid "No processing run has completed for more than %d seconds."
msgstr "Geen verwerkingsuitvoering is vir langer as %d sekondes voltooi nie."

#: includes/functions.php
msgid "Incoming messages are within the configured limits."
msgstr "Inkomende boodskappe is binne die gekonfigureerde limiete."

#: includes/functions.php
msgid "Incoming queue metrics are unavailable."
msgstr "Inkomende wagrymetrieke is onbeskikbaar."

#: includes/functions.php
#, php-format
msgid "Incoming backlog of at least %s messages exceeds the limit of %s."
msgstr "Inkomende agterstand van minstens %s boodskappe oorskry die limiet van %s."

#: includes/functions.php
msgid "The oldest incoming message timestamp is unavailable."
msgstr "Die oudste inkomende boodskap se tydstempel is nie beskikbaar nie."

#: includes/functions.php
#, php-format
msgid "Unprocessed messages are older than %d seconds."
msgstr "Onverwerkte boodskappe is ouer as %d sekondes."

#: includes/functions.php
msgid "Synchronization is not enabled on this collector."
msgstr "Sinchronisasie is nie op hierdie versamelaar geaktiveer nie."

#: includes/functions.php
msgid "Synchronization is within the allowed delay."
msgstr "Sinchronisasie is binne die toegelate vertraging."

#: includes/functions.php
msgid "Synchronization queue metrics are unavailable."
msgstr "Metrieke vir die sinchronisasiewagry is nie beskikbaar nie."

#: includes/functions.php
msgid "The oldest synchronization record timestamp is unavailable."
msgstr "Die oudste sinchronisasierekord se tydstempel is nie beskikbaar nie."

#: includes/functions.php
msgid "Synchronization has failed or queued records exceed the allowed delay."
msgstr "Sinchronisasie het misluk of rekords in die wagry oorskry die toegelate vertraging."

#: includes/functions.php
msgid "Partition maintenance is not blocked."
msgstr "Partisie-onderhoud is nie geblokkeer nie."

