#, php-format
msgid "Syslog pipeline health - collector %d"
msgstr "Syslog-pyplyngesondheid - versamelaar %d"

#: includes/functions.php
msgid "The Syslog pipeline has recovered."
msgstr "Die Syslog-pyplyn het herstel."

#: includes/functions.php
#, php-format
msgid "Partition layout for %s is invalid or incomplete; partition maintenance stopped. Verify the partition metadata with SHOW CREATE TABLE and, if required, rebuild the partitions; writes continue into the dMaxValue safety partition."
msgstr "Partisie-uitleg vir %s is ongeldig of onvolledig; partisie-onderhoud is gestop. Verifieer die partisiemetadata met SHOW CREATE TABLE en herbou die partisies indien nodig; skryfbewerkings gaan voort in die dMaxValue-veiligheidspartisie."

#: includes/functions.php
#, php-format
msgid "remaining partition gap: %d partition(s)"
msgstr "oorblywende partisiegaping: %d partisie(s)"

#: includes/functions.php
msgid "no retention deferral"
msgstr "geen retensie-uitstel nie"

#: includes/functions.php
msgid "retention pruning deferred until the future horizon is restored"
msgstr "retensiesnoei uitgestel totdat die toekomstige horison herstel is"

#: includes/functions.php
msgid "new records are accumulating in the dMaxValue safety partition"
msgstr "nuwe rekords hoop op in die dMaxValue-veiligheidspartisie"

#: includes/functions.php
msgid "per run recovery limit reached"
msgstr "herstellimiet per lopie bereik"

#: includes/functions.php
msgid "partition creation failed"
msgstr "partisieskepping het misluk"

#: includes/functions.php
msgid "Unknown partitioning level; choose Hourly or Daily."
msgstr "Onbekende partisioneringsvlak; kies Uurliks of Daagliks."

#: includes/functions.php
msgid "The Syslog retention is invalid."
msgstr "Die Syslog-retensie is ongeldig."

#: includes/functions.php
msgid "Hourly partitioning cannot be used with Indefinite retention, which would need an unbounded number of partitions. Choose a retention period or Daily partitioning."
msgstr "Uurlikse partisionering kan nie saam met onbepaalde bewaring gebruik word nie, aangesien dit 'n onbeperkte aantal partisies sou benodig. Kies 'n bewaringstydperk of daaglikse partisionering."

#: includes/functions.php
#, php-format
msgid "%s partitioning with %s days of retention and a %s day pre-create window needs %s partitions per table, which exceeds this database server's limit of %s partitions. Reduce the retention, shorten the pre-create window, or choose Daily partitioning."
msgstr "%s-partisionering met %s dae se bewaring en 'n %s-dae voorafskepvenster benodig %s partisies per tabel, wat hierdie databasisbediener se perk van %s partisies oorskry. Verminder die bewaring, verkort die voorafskepvenster, of kies Daaglikse partisionering."

